<UserControl x:Class="PosnaiSQLauncher.NewSaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Border x:Name="MainBorder" CornerRadius="20" Background="#E8FFFFFF" Margin="40" 
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="700">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.25" BlurRadius="16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- STEPPER (Твой оригинальный стиль) -->
                <Border Grid.Row="0" Margin="30,25,30,20">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- ШАГ 1 -->
                        <StackPanel Grid.Column="0" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White">
                                <TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="БД" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- ШАГ 2 -->
                        <StackPanel Grid.Column="2" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White">
                                <TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Запрос" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Rectangle Grid.Column="3" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- ШАГ 3 -->
                        <StackPanel Grid.Column="4" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White">
                                <TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Уровень" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Rectangle Grid.Column="5" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- ШАГ 4 - АКТИВНЫЙ -->
                        <StackPanel Grid.Column="6">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#2196F3">
                                <TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Обзор" FontSize="10" Foreground="#666666" Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- КОНТЕНТ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,10,30,20">
                        <TextBlock Text="Завершение настройки" FontSize="24" FontWeight="Bold" Foreground="#1a1a1a" Margin="0,0,0,8" TextAlignment="Center"/>
                        <TextBlock Text="Сохраните новый вариант" FontSize="13" Foreground="#666666" Margin="0,0,0,30" TextAlignment="Center"/>

                        <Border Background="#102196F3" CornerRadius="20" Padding="35" MinWidth="550">
                            <StackPanel>
                                <!-- Иконка -->
                                <TextBlock Text="💾" FontSize="50" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
                                <!-- Текст с форматированием -->
                                <TextBlock FontSize="13" 
                                           Foreground="#1E88E5" 
                                           HorizontalAlignment="Center" 
                                           TextAlignment="Center" 
                                           TextWrapping="Wrap" 
                                           LineHeight="20"
                                           MaxWidth="500">
                                    После нажатия кнопки <Bold>"Сохранить"</Bold> созданный вариант будет записан в базу данных. 
                                    В дальнейшем его можно изменить через режим редактирования. 
                                    <LineBreak/><LineBreak/>
                                    Для того чтобы использовать созданные варианты в игровом клиенте — необходимо воспользоваться меню <Bold>"Экспорт"</Bold>.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- КНОПКИ -->
                <Border Grid.Row="2" Margin="30,10,30,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="← Назад" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Click="Back_Click" 
                                HorizontalAlignment="Stretch"
                                MinWidth="0" Width="Auto"/>

                        <Button Grid.Column="2" 
                                Content="Сохранить вариант" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Click="Save_Click" 
                                HorizontalAlignment="Stretch"
                                MinWidth="0" Width="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>