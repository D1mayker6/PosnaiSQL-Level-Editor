<UserControl x:Class="PosnaiSQLauncher.SaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Border x:Name="MainBorder" CornerRadius="20" Background="#E8FFFFFF" Margin="40" 
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="750">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.25" BlurRadius="16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Stepper -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- STEPPER -->
                <Border Grid.Row="0" Margin="30,25,30,20">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="БД" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="1" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Запрос" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="3" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Уровень" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="5" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="6"><Border Width="36" Height="36" CornerRadius="18" Background="#2196F3"><TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Обзор" FontSize="10" Foreground="#666666" Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                </Border>

                <!-- КОНТЕНТ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="40,10,40,30">
                        <TextBlock Text="Завершение настройки" FontSize="26" FontWeight="Bold" Foreground="#1a1a1a" Margin="0,0,0,8" TextAlignment="Center"/>
                        <TextBlock Text="Проверьте данные и подтвердите сохранение" FontSize="14" Foreground="#666666" Margin="0,0,0,40" TextAlignment="Center"/>

                        <Border Background="#F5F9FF" CornerRadius="25" Padding="40" MinWidth="600">
                            <StackPanel>
                                <!-- НОВАЯ ИКОНКА SAVE.PNG -->
                                <Border Width="110" Height="110" Background="White" CornerRadius="55" Margin="0,0,0,25" HorizontalAlignment="Center">
                                    <Border.Effect><DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="5"/></Border.Effect>
                                    <Image Source="pack://application:,,,/Assets/save.png" Width="60" Height="60" Stretch="Uniform"/>
                                </Border>
        
                                <!-- Текст описания -->
                                <TextBlock FontSize="14" Foreground="#1E88E5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" MaxWidth="550">
                                    Созданный вариант будет записан в общую базу данных. 
                                    Вы сможете найти его в разделе <Bold>"Редактировать существующий вариант"</Bold> по названию выбранного запроса.
                                    <LineBreak/><LineBreak/>
                                    <Span Foreground="#666666" FontSize="12">
                                        Для использования в игре не забудьте выполнить <Italic>экспорт</Italic> после завершения работы.
                                    </Span>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- КНОПКИ -->
                <Border Grid.Row="2" Margin="30,10,30,40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="← Назад" Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click" Height="55"/>
                        <Button Grid.Column="2" Content="💾 Сохранить вариант" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" Height="55"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- КОНТЕЙНЕР ЗАГРУЗКИ -->
        <Grid x:Name="LoadingOverlayContainer" Panel.ZIndex="1000" Visibility="Collapsed"/>
    </Grid>
</UserControl>