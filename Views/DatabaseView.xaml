<UserControl x:Class="PosnaiSQLauncher.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">
    
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1"
                                   Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.Resources>
        <Style x:Key="StyledComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                        Focusable="false" 
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                        ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate>
                                        <Border Background="White" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#2196F3"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter x:Name="ContentSite" 
                                            IsHitTestVisible="False" 
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                            Margin="12,0,40,0" 
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"/>
                            
                            <Popup x:Name="Popup" 
                                  Placement="Bottom" 
                                  IsOpen="{TemplateBinding IsDropDownOpen}" 
                                  AllowsTransparency="True" 
                                  Focusable="False" 
                                  PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <Border Background="White" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="8" Margin="0,5,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="4" Color="#000000" Opacity="0.1" BlurRadius="10"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border x:Name="MainBorder"
                CornerRadius="20"
                Background="#E8FFFFFF"
                Margin="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.25" BlurRadius="16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="30,25,30,20" BorderThickness="0,0,0,0">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#2196F3" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="БД" FontSize="10" Foreground="#666666" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" Background="White" 
                                   BorderThickness="2" BorderBrush="#CCCCCC" HorizontalAlignment="Center">
                                <TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Запрос" FontSize="10" Foreground="#999999" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" Background="White" 
                                   BorderThickness="2" BorderBrush="#CCCCCC" HorizontalAlignment="Center">
                                <TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Параметры" FontSize="10" Foreground="#999999" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Rectangle Grid.Column="5" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" Background="White" 
                                   BorderThickness="2" BorderBrush="#CCCCCC" HorizontalAlignment="Center">
                                <TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Сохранение" FontSize="10" Foreground="#999999" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MainContent" Margin="30,20,30,20" VerticalAlignment="Top" HorizontalAlignment="Center">
                        
                        <Grid MinWidth="550" Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                <TextBlock Text="Настройка базы данных" 
                                           FontSize="24" FontWeight="Bold" Foreground="#1a1a1a"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="SubtitleText"
                                           Text="Заполните информацию о базе данных"
                                           FontSize="13" Foreground="#666666"/>
                            </StackPanel>

                            <Button x:Name="ToggleEditButton"
                                    Grid.Column="1"
                                    Content="🔒 Разрешить изменение"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="42"
                                    Padding="15,0"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Click="ToggleEditButton_Click"/>
                        </Grid>

                        <StackPanel MinWidth="550">
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="Имя базы данных"
                                          FontSize="14" Foreground="#1a1a1a" 
                                          Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <TextBox x:Name="DatabaseNameTextBox"
                                        Height="40"
                                        FontSize="14"
                                        Padding="12,0,12,0"
                                        VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Схема базы данных"
                                               FontSize="14" Foreground="#1a1a1a" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="BrowseImageButton"
                                            Grid.Column="2"
                                            Content="📁 Обзор"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseImage_Click"
                                            MinWidth="100"
                                            Height="35"
                                            Padding="8,4,8,4"
                                            FontSize="12"/>
                                </Grid>

                                <Border x:Name="ImagePreviewBorder"
                                        Width="350" Height="350"
                                        BorderThickness="2"
                                        BorderBrush="#E0E0E0"
                                        CornerRadius="10"
                                        Background="#F9F9F9"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="ImagePreview"
                                               Stretch="Uniform"/>
            
                                        <StackPanel x:Name="ImagePlaceholder"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="🖼️" FontSize="80" 
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock Text="Выберите схему"
                                                    FontSize="13" Foreground="#999999"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="30,10,30,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="← Назад"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="50"
                                Click="Back_Click"/>

                        <Button Grid.Column="2"
                                Content="Далее →"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="50"
                                Name="NextButton"
                                Click="Next_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="DatabaseSelectorOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="100">
            <Border Background="#E8FFFFFF"
                    CornerRadius="15"
                    Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    x:Name="DatabaseSelectorPanel">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="10" Color="#000000" Opacity="0.3" BlurRadius="20"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="White" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Выберите базу данных"
                                  FontSize="22" FontWeight="Bold" Foreground="#1a1a1a"
                                  Margin="30,20,0,20" VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                               Content="✕"
                               Click="CloseDatabaseSelector_Click"
                               Width="50"
                               Height="50"
                               Background="Transparent"
                               BorderThickness="0"
                               FontSize="24"
                               Foreground="#999999"
                               Cursor="Hand"
                               VerticalAlignment="Top">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F0F0F0"/>
                                            <Setter Property="Foreground" Value="#E53935"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="30,15,30,30">
                        <TextBlock Text="Выберите существующую базу данных из списка"
                                  FontSize="13" Foreground="#666666" 
                                  Margin="0,0,0,20" TextAlignment="Center"/>

                        <ComboBox x:Name="DatabaseComboBox"
                                  Height="50"
                                 Margin="0,0,0,25"
                                 SelectionChanged="DatabaseComboBox_SelectionChanged"
                                  Style="{StaticResource StyledComboBox}">
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="DeleteDatabaseButton"
                                    Grid.Column="0"
                                    Content="🗑  Удалить"
                                    Height="50"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Foreground="#E53935"
                                    BorderBrush="#E53935"
                                    IsEnabled="False"
                                    Click="DeleteDatabase_Click"/>

                            <Button x:Name="SelectDatabaseButton"
                                    Grid.Column="2"
                                    Content="Выбрать"
                                    Height="50"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="False"
                                    Click="SelectDatabase_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="LoadingOverlayContainer" Visibility="Collapsed" Panel.ZIndex="1000"/>
    </Grid>
</UserControl>