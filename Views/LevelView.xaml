<UserControl x:Class="PosnaiSQLauncher.LevelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">

    <UserControl.Resources>
        <Style x:Key="TimerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="55"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Border x:Name="MainBorder" CornerRadius="20" Background="#E8FFFFFF" Margin="40" 
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="850">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.25" BlurRadius="16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="30,25,30,20">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="БД" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="1" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Запрос" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="3" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4"><Border Width="36" Height="36" CornerRadius="18" Background="#2196F3"><TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Параметры" FontSize="10" Foreground="#666666" Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                        <Rectangle Grid.Column="5" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="6" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Сохранение" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="40,0,40,25">
                        <TextBlock Text="Выбор локации" FontSize="26" FontWeight="Bold" Foreground="#1a1a1a" Margin="0,0,0,8" TextAlignment="Center"/>
                        <TextBlock Text="Выберите атмосферу игрового уровня" FontSize="14" Foreground="#666666" Margin="0,0,0,35" TextAlignment="Center"/>

                        <Grid HorizontalAlignment="Center" Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border x:Name="CardDesert" Grid.Column="0" CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="CardDesert_Click">
                                <Border.Effect><DropShadowEffect ShadowDepth="4" Color="#000000" Opacity="0.1" BlurRadius="10"/></Border.Effect>
                                <StackPanel Margin="25">
                                    <Border Width="100" Height="100" Background="#FFF3E0" CornerRadius="50" Margin="0,5,0,20">
                                        <Image Source="pack://application:,,,/Assets/desert.png" Width="60" Height="60" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Знойная пустыня" FontSize="20" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="Суровые дюны, где точность каждого запроса важна для выживания." FontSize="12" Foreground="#777777" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardForest" Grid.Column="2" CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="CardForest_Click">
                                <Border.Effect><DropShadowEffect ShadowDepth="4" Color="#000000" Opacity="0.1" BlurRadius="10"/></Border.Effect>
                                <StackPanel Margin="25">
                                    <Border Width="100" Height="100" Background="#E8F5E9" CornerRadius="50" Margin="0,5,0,20">
                                        <Image Source="pack://application:,,,/Assets/forest.png" Width="60" Height="60" Stretch="Uniform"/>
                                    </Border>
                                    <TextBlock Text="Шёпот листвы" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="Спокойствие древнего леса поможет разгадать сложные связи данных." FontSize="12" Foreground="#777777" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Лимит времени" FontSize="18" Foreground="#1a1a1a" Margin="0,0,0,15" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border Background="#08000000" CornerRadius="18" Padding="20,15" HorizontalAlignment="Center" MinWidth="480">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="-30" Click="TimeMinus30_Click" Style="{StaticResource TimerButtonStyle}"/>
                                    <Button Content="-5" Click="TimeMinus5_Click" Style="{StaticResource TimerButtonStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Width="75">
                                        <TextBlock x:Name="MinDisplay" Text="05" FontSize="48" FontWeight="Bold" Foreground="#1a1a1a" TextAlignment="Center"/>
                                        <TextBlock Text="МИН" FontSize="10" Foreground="#999999" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,-5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=":" FontSize="48" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2196F3" Margin="8,-10,8,0"/>
                                    <StackPanel Width="75">
                                        <TextBlock x:Name="SecDisplay" Text="00" FontSize="48" FontWeight="Bold" Foreground="#1a1a1a" TextAlignment="Center"/>
                                        <TextBlock Text="СЕК" FontSize="10" Foreground="#999999" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,-5,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="+5" Click="TimePlus5_Click" Style="{StaticResource TimerButtonStyle}"/>
                                    <Button Content="+30" Click="TimePlus30_Click" Style="{StaticResource TimerButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="30,10,30,35">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Назад" Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click" Height="55"/>
                        <Button Grid.Column="2" x:Name="NextButton" Content="Далее" Style="{StaticResource PrimaryButtonStyle}" Click="Next_Click" IsEnabled="False" Height="55"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>