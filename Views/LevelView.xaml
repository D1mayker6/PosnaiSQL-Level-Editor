<UserControl x:Class="PosnaiSQLauncher.LevelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">

    <UserControl.Resources>
        <!-- СТИЛЬ ДЛЯ КНОПОК ТАЙМЕРА: перебиваем глобальный MinWidth -->
        <Style x:Key="TimerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="0"/> <!-- Убираем 320px -->
            <Setter Property="Width" Value="50"/>   <!-- Фиксируем ширину -->
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- БЕЛЫЙ БЛОК: меняем Width на MaxWidth для адаптивности -->
        <Border x:Name="MainBorder" CornerRadius="20" Background="#E8FFFFFF" Margin="40" 
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="800">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.25" BlurRadius="16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Stepper -->
                    <RowDefinition Height="*"/>    <!-- Scroll Content -->
                    <RowDefinition Height="Auto"/> <!-- Nav Buttons -->
                </Grid.RowDefinitions>

                <!-- ФОНОВЫЕ СЛОИ -->
                <Image x:Name="BgTexture" Opacity="0" Stretch="Fill" Grid.RowSpan="3" IsHitTestVisible="False"/>
                <Border x:Name="BgOverlay" Background="White" Opacity="0.95" CornerRadius="20" Grid.RowSpan="3" IsHitTestVisible="False"/>

                <!-- 1. STEPPER -->
                <Border Grid.Row="0" Margin="30,25,30,20">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="БД" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="1" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Запрос" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="3" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4"><Border Width="36" Height="36" CornerRadius="18" Background="#2196F3"><TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Уровень" FontSize="10" Foreground="#666666" Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                        <Rectangle Grid.Column="5" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="6" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Обзор" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Grid>
                </Border>

                <!-- 2. КОНТЕНТ (SCROLLABLE) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,0,30,20">
                        <TextBlock Text="Выбор локации" FontSize="24" FontWeight="Bold" Foreground="#1a1a1a" Margin="0,0,0,8" TextAlignment="Center"/>
                        <TextBlock Text="Выберите локацию для будущего игрового уровня" FontSize="13" Foreground="#666666" Margin="0,0,0,30" TextAlignment="Center"/>

                        <!-- КАРТОЧКИ -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CardDesert" Grid.Column="0" CornerRadius="15" Background="White" BorderThickness="2" BorderBrush="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="CardDesert_Click" MinWidth="280" MaxWidth="320">
                                <Border.Effect><DropShadowEffect ShadowDepth="2" Color="#000000" Opacity="0.08" BlurRadius="6"/></Border.Effect>
                                <StackPanel Margin="20">
                                    <Border Width="80" Height="80" Background="#FFF3E0" CornerRadius="40" Margin="0,5,0,15"><Image Source="pack://application:,,,/Assets/desert.png" Width="45" Height="45" Stretch="Uniform"/></Border>
                                    <TextBlock Text="Знойная пустыня" FontSize="18" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Суровые дюны, где точность каждого запроса важна для выживания." FontSize="11" Foreground="#777777" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CardForest" Grid.Column="2" CornerRadius="15" Background="White" BorderThickness="2" BorderBrush="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="CardForest_Click" MinWidth="280" MaxWidth="320">
                                <Border.Effect><DropShadowEffect ShadowDepth="2" Color="#000000" Opacity="0.08" BlurRadius="6"/></Border.Effect>
                                <StackPanel Margin="20">
                                    <Border Width="80" Height="80" Background="#E8F5E9" CornerRadius="40" Margin="0,5,0,15"><Image Source="pack://application:,,,/Assets/forest.png" Width="45" Height="45" Stretch="Uniform"/></Border>
                                    <TextBlock Text="Шёпот листвы" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="Спокойствие древнего леса поможет разгадать сложные связи данных." FontSize="11" Foreground="#777777" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ТАЙМЕР -->
                        <TextBlock Text="Лимит времени" FontSize="16" Foreground="#1a1a1a" Margin="0,0,0,15" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <Border Background="#08000000" CornerRadius="15" Padding="15,10" HorizontalAlignment="Center" MinWidth="450">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- -30 -5 -->
                                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                    <ColumnDefinition Width="Auto"/> <!-- Time -->
                                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                                    <ColumnDefinition Width="Auto"/> <!-- +5 +30 -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="-30" Click="TimeMinus30_Click" Style="{StaticResource TimerButtonStyle}"/>
                                    <Button Content="-5" Click="TimeMinus5_Click" Style="{StaticResource TimerButtonStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Width="65">
                                        <TextBlock x:Name="MinDisplay" Text="05" FontSize="42" FontWeight="Bold" Foreground="#1a1a1a" TextAlignment="Center"/>
                                        <TextBlock Text="МИН" FontSize="9" Foreground="#999999" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,-5,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text=":" FontSize="42" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2196F3" Margin="5,-10,5,0"/>
                                    <StackPanel Width="65">
                                        <TextBlock x:Name="SecDisplay" Text="00" FontSize="42" FontWeight="Bold" Foreground="#1a1a1a" TextAlignment="Center"/>
                                        <TextBlock Text="СЕК" FontSize="9" Foreground="#999999" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,-5,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="+5" Click="TimePlus5_Click" Style="{StaticResource TimerButtonStyle}"/>
                                    <Button Content="+30" Click="TimePlus30_Click" Style="{StaticResource TimerButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. КНОПКИ НАВИГАЦИИ (РАСТЯНУТЫЕ) -->
                <Border Grid.Row="2" Margin="30,10,30,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="← Назад" Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click" HorizontalAlignment="Stretch" MinWidth="0" Width="Auto"/>
                        <Button Grid.Column="2" x:Name="NextButton" Content="Далее →" Style="{StaticResource PrimaryButtonStyle}" Click="Next_Click" IsEnabled="False" HorizontalAlignment="Stretch" MinWidth="0" Width="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>