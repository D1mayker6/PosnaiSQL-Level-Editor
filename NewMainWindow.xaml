<Window x:Class="PosnaiSQLauncher.NewMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Познай SQL!"
        Height="650"
        Width="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ФОНОВЫЙ ГРАДИЕНТ ДЛЯ ВСЕГО ОКНА -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1565C0" Offset="0"/>
                <GradientStop Color="#0D47A1" Offset="0.5"/>
                <GradientStop Color="#1E88E5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Панель управления окном БЕЗ ВЫДЕЛЕНИЯ -->
        <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Перетаскиваемая область -->
            <Rectangle Grid.Column="0" Fill="Transparent"/>

            <!-- Системные кнопки - БЕЛЫЕ И МАЛЕНЬКИЕ -->
            <StackPanel Grid.Column="1" 
                       Orientation="Horizontal" 
                       Margin="0,0,8,0"
                       VerticalAlignment="Center">
                <Button Style="{StaticResource SystemButtonStyle}" 
                       Content="−" 
                       Click="Minimize_Click"
                       ToolTip="Свернуть"
                       Margin="4,0,0,0"/>
                
                <Button x:Name="MaximizeBtn"
                       Style="{StaticResource SystemButtonStyle}" 
                       Content="☐" 
                       Click="Maximize_Click"
                       ToolTip="Развернуть"
                       Margin="4,0,0,0"/>
                
                <Button Style="{StaticResource SystemButtonStyle}" 
                       Content="✕" 
                       Click="Close_Click"
                       ToolTip="Закрыть"
                       Foreground="White"
                       Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Контейнер для контента -->
        <ContentControl x:Name="MainContent" Grid.Row="1"/>
    </Grid>
</Window>