<UserControl x:Class="PosnaiSQLauncher.NewExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- БЕЛЫЙ БЛОК -->
        <Border x:Name="MainBorder" CornerRadius="20" Background="#E8FFFFFF" Margin="40" 
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="800" Width="750">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.25" BlurRadius="16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Stepper -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- 1. STEPPER (ШАГ 4) -->
                <Border Grid.Row="0" Margin="30,25,30,20">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="БД" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="1" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Запрос" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="3" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4" Opacity="0.5"><Border Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="#CCCCCC" Background="White"><TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Уровень" FontSize="10" Foreground="#999999" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                        <Rectangle Grid.Column="5" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="6"><Border Width="36" Height="36" CornerRadius="18" Background="#2196F3"><TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Обзор" FontSize="10" Foreground="#666666" Margin="0,6,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                </Border>

                <!-- 2. КОНТЕНТ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="30,10,30,20">
                        <TextBlock Text="Завершение и экспорт" FontSize="24" FontWeight="Bold" Foreground="#1a1a1a" Margin="0,0,0,8" TextAlignment="Center"/>
                        <TextBlock Text="Выберите формат и место сохранения" FontSize="13" Foreground="#666666" Margin="0,0,0,30" TextAlignment="Center"/>

                        <Grid HorizontalAlignment="Center" Margin="0,0,0,35">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                            <Border x:Name="CardJson" Grid.Column="0" CornerRadius="15" Background="White" BorderThickness="2" BorderBrush="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="CardJson_Click">
                                <Border.Effect><DropShadowEffect ShadowDepth="2" Color="#000000" Opacity="0.08" BlurRadius="6"/></Border.Effect>
                                <StackPanel Margin="20">
                                    <Border Width="80" Height="80" Background="#FFF3E0" CornerRadius="40" Margin="0,5,0,15"><TextBlock Text="{}{ }" FontSize="32" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="Формат JSON" FontSize="18" FontWeight="Bold" Foreground="#1a1a1a" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="Для веб-интеграций." FontSize="11" Foreground="#888888" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="CardExcel" Grid.Column="2" CornerRadius="15" Background="White" BorderThickness="2" BorderBrush="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="CardExcel_Click">
                                <Border.Effect><DropShadowEffect ShadowDepth="2" Color="#000000" Opacity="0.08" BlurRadius="6"/></Border.Effect>
                                <StackPanel Margin="20">
                                    <Border Width="80" Height="80" Background="#E8F5E9" CornerRadius="40" Margin="0,5,0,15"><TextBlock Text="XLS" FontSize="28" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="Формат Excel" FontSize="18" FontWeight="Bold" Foreground="#1a1a1a" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="Для табличных отчетов." FontSize="11" Foreground="#888888" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Путь сохранения" FontSize="14" Foreground="#1a1a1a" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathTextBox" Height="45" FontSize="13" Padding="12,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F9F9F9" BorderBrush="#E0E0E0"/>
                            
                            <!-- Кнопка Обзор: убран фиксированный MinWidth, добавлен Padding -->
                            <Button Grid.Column="2" Content="Обзор" Click="Browse_Click" Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="45" MinWidth="110" Padding="15,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. КНОПКИ (ЭКСПОРТ ПО ЦЕНТРУ) -->
                <Border Grid.Row="2" Margin="30,10,30,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="← Назад" Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click" HorizontalAlignment="Left" Width="140" MinWidth="0"/>
                        
                        <Button Grid.Column="1" x:Name="ExportButton" Content="Экспортировать результат" Style="{StaticResource PrimaryButtonStyle}" 
                                IsEnabled="False" Click="Export_Click" HorizontalAlignment="Center" Width="300" MinWidth="0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>