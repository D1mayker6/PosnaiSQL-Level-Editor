<UserControl x:Class="PosnaiSQLauncher.NewExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">

    <UserControl.Resources>
        <!-- СТИЛЬ ЭЛЕМЕНТА СПИСКА -->
        <Style x:Key="VariantItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="10" Background="Transparent" 
                                BorderThickness="1.5" BorderBrush="#F0F0F0" Margin="0,0,5,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" 
                                          VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <CheckBox.RenderTransform>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                    </CheckBox.RenderTransform>
                                </CheckBox>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="5,10,15,10"
                                                  TextElement.FontSize="14" TextElement.FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8F9FA"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Блок адаптируется по высоте контента -->
        <Border x:Name="MainBorder" CornerRadius="20" Background="#E8FFFFFF" 
                Margin="30" Width="800" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" Color="Black" Opacity="0.2" BlurRadius="15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Content (Scroll) -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- 1. ЗАГОЛОВОК -->
                <StackPanel Grid.Row="0" Margin="30,25,30,10">
                    <TextBlock Text="Экспорт вариантов" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1a1a1a"/>
                    <TextBlock Text="Массовая выгрузка созданных задач" FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 2. КОНТЕНТ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <StackPanel Margin="40,5,40,20">
                        
                        <!-- ВЫБОР -->
                        <TextBlock Text="1. Выберите варианты" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="#2196F3"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="10" Background="White" Height="42" Margin="0,0,0,10">
                            <Grid>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" TextChanged="SearchBox_TextChanged"/>
                                <TextBlock Text="🔍 Поиск..." Margin="12,0" VerticalAlignment="Center" Foreground="#999999" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="2" Height="140">
                            <ListBox x:Name="VariantsListBox" ItemContainerStyle="{StaticResource VariantItemStyle}" SelectionMode="Multiple" BorderThickness="0" Margin="5" HorizontalContentAlignment="Stretch" SelectionChanged="VariantsListBox_SelectionChanged">
                                <ListBoxItem Content="Вариант 101 : Основы SELECT"/>
                                <ListBoxItem Content="Вариант 102 : Работа с WHERE"/>
                                <ListBoxItem Content="Вариант 105 : Группировка данных"/>
                            </ListBox>
                        </Border>
                        <TextBlock x:Name="SelectedCountText" Text="Выбрано: 0" FontSize="12" FontWeight="SemiBold" Foreground="#2196F3" Margin="5,5,0,20"/>

                        <!-- ФОРМАТ (КРУПНЫЕ КАРТОЧКИ) -->
<!-- ФОРМАТ (КАК В ВЫБОРЕ УРОВНЯ) -->
<TextBlock Text="2. Выберите формат"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,0,0,15"
           Foreground="#2196F3"/>

<Grid HorizontalAlignment="Center" Margin="0,0,0,25">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- JSON -->
    <Border x:Name="CardJson"
            Grid.Column="0"
            CornerRadius="15"
            Background="White"
            BorderThickness="2"
            BorderBrush="#E0E0E0"
            Cursor="Hand"
            MouseLeftButtonDown="CardJson_Click"
            MinWidth="280"
            MaxWidth="320">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="2"
                              Color="#000000"
                              Opacity="0.08"
                              BlurRadius="6"/>
        </Border.Effect>

        <StackPanel Margin="20">
            <Border Width="80"
                    Height="80"
                    Background="#FFF3E0"
                    CornerRadius="40"
                    Margin="0,5,0,15"
                    HorizontalAlignment="Center">
                <TextBlock Text="{}{ }"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#E65100"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Формат JSON"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#E65100"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Для связи с игровым клиентом"
                       FontSize="11"
                       Foreground="#777777"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>

    <!-- EXCEL -->
    <Border x:Name="CardExcel"
            Grid.Column="2"
            CornerRadius="15"
            Background="White"
            BorderThickness="2"
            BorderBrush="#E0E0E0"
            Cursor="Hand"
            MouseLeftButtonDown="CardExcel_Click"
            MinWidth="280"
            MaxWidth="320">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="2"
                              Color="#000000"
                              Opacity="0.08"
                              BlurRadius="6"/>
        </Border.Effect>

        <StackPanel Margin="20">
            <Border Width="80"
                    Height="80"
                    Background="#E8F5E9"
                    CornerRadius="40"
                    Margin="0,5,0,15"
                    HorizontalAlignment="Center">
                <TextBlock Text="📊"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Формат Excel"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#2E7D32"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Для учета и анализа"
                       FontSize="11"
                       Foreground="#777777"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Grid>

                        <!-- ПАПКА -->
                        <TextBlock Text="3. Папка сохранения" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="#2196F3"/>
                        <Grid Height="55">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="#E0E0E0" BorderThickness="2" CornerRadius="10" Background="#F9F9F9">
                                <TextBox x:Name="PathTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="15,0" FontSize="13"/>
                            </Border>
                            <Button Grid.Column="1" Content="📁 Обзор" Click="Browse_Click" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Height="55" Margin="15,0,0,0" MinWidth="110" Padding="15,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. ФУТЕР -->
                <Border Grid.Row="2" Background="#08000000" Padding="40,25" CornerRadius="0,0,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="← Назад" Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click" MinWidth="140" Height="50" Padding="15,0"/>
                        <Button Grid.Column="2" x:Name="ExportButton" Content="📩 Начать экспорт" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="Export_Click" MinWidth="260" Height="50" Padding="15,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>