<UserControl x:Class="PosnaiSQLauncher.DatabaseConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">
    
    <!-- Анимация появления -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1"
                                   Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- БЕЛЫЙ БЛОК -->
        <Border x:Name="MainBorder"
                CornerRadius="20"
                Background="#E8FFFFFF"
                Margin="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.25" BlurRadius="16"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- STEPPER С МОСТИКАМИ -->
                <Border Grid.Row="0" Margin="30,25,30,20" BorderThickness="0,0,0,0">
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- ШАГ 1 - АКТИВНЫЙ -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#2196F3" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="1" FontSize="16" FontWeight="Bold" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="БД" FontSize="10" Foreground="#666666" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- МОСТИК 1 -->
                        <Rectangle Grid.Column="1" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- ШАГ 2 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" Background="White" 
                                   BorderThickness="2" BorderBrush="#CCCCCC" HorizontalAlignment="Center">
                                <TextBlock Text="2" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Запрос" FontSize="10" Foreground="#999999" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- МОСТИК 2 -->
                        <Rectangle Grid.Column="3" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- ШАГ 3 -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" Background="White" 
                                   BorderThickness="2" BorderBrush="#CCCCCC" HorizontalAlignment="Center">
                                <TextBlock Text="3" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Уровень" FontSize="10" Foreground="#999999" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- МОСТИК 3 -->
                        <Rectangle Grid.Column="5" Height="2" Fill="#D0D0D0" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- ШАГ 4 -->
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Opacity="0.5">
                            <Border Width="36" Height="36" CornerRadius="18" Background="White" 
                                   BorderThickness="2" BorderBrush="#CCCCCC" HorizontalAlignment="Center">
                                <TextBlock Text="4" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Обзор" FontSize="10" Foreground="#999999" Margin="0,6,0,0"
                                      HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- КОНТЕНТ -->
                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MainContent" Margin="30,20,30,20" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <!-- ЗАГОЛОВОК -->
                        <TextBlock Text="Настройка базы данных" 
                                  FontSize="24" FontWeight="Bold" Foreground="#1a1a1a"
                                  Margin="0,0,0,8" TextAlignment="Center"/>
                        <TextBlock x:Name="SubtitleText"
                                  Text="Заполните информацию о базе данных"
                                  FontSize="13" Foreground="#666666" Margin="0,0,0,25" TextAlignment="Center"/>

                        <!-- ПОЛЯ ВВОДА -->
                        <StackPanel MinWidth="550">
                            <!-- ИМЯ БАЗЫ ДАННЫХ -->
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="Имя базы данных"
                                          FontSize="14" Foreground="#1a1a1a" 
                                          Margin="0,0,0,8" FontWeight="SemiBold"/>
                                <TextBox x:Name="DatabaseNameTextBox"
                                        Height="40"
                                        FontSize="14"
                                        Padding="12,0,12,0"
                                        VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- СХЕМА БАЗЫ ДАННЫХ -->
                            <StackPanel Margin="0,0,0,20">
                                <!-- ЗАГОЛОВОК И КНОПКА -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Схема базы данных"
                                               FontSize="14" Foreground="#1a1a1a" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="2"
                                            Content="📁 Обзор"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="BrowseImage_Click"
                                            MinWidth="100"
                                            Height="35"
                                            Padding="8,4,8,4"
                                            FontSize="12"/>
                                </Grid>

                                <!-- ОБЛАСТЬ ДЛЯ ФОТОГРАФИИ -->
                                <Border x:Name="ImagePreviewBorder"
                                        Width="350" Height="350"
                                        BorderThickness="2"
                                        BorderBrush="#E0E0E0"
                                        CornerRadius="10"
                                        Background="#F9F9F9"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <!-- ИЗОБРАЖЕНИЕ -->
                                        <Image x:Name="ImagePreview"
                                               Stretch="Uniform"/>
            
                                        <!-- ПЛЕЙСХОЛДЕР (показывается когда изображения нет) -->
                                        <StackPanel x:Name="ImagePlaceholder"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="🖼️" FontSize="80" 
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Выберите схему"
                                                       FontSize="13" Foreground="#999999"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- КНОПКИ -->
                <Border Grid.Row="2" Margin="30,10,30,30" BorderThickness="0,0,0,0">
                    <Grid HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                               Content="← Назад"
                               Style="{StaticResource SecondaryButtonStyle}"
                               Click="Back_Click"/>

                        <Button x:Name="NextButton"
                               Grid.Column="2"
                               Content="Далее →"
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="Next_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ОВЕРЛЕЙ С ВЫБОРОМ БД -->
        <Grid x:Name="DatabaseSelectorOverlay" Visibility="Collapsed" Background="#80000000" Panel.ZIndex="100">
            <!-- МОДАЛЬНОЕ ОКНО -->
            <Border Background="#E8FFFFFF"
                    CornerRadius="15"
                    Width="500"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    x:Name="DatabaseSelectorPanel">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="10" Color="#000000" Opacity="0.3" BlurRadius="20"/>
                </Border.Effect>

                <StackPanel Margin="30">
                    <!-- ЗАГОЛОВОК -->
                    <TextBlock Text="Выберите базу данных" 
                              FontSize="22" FontWeight="Bold" Foreground="#1a1a1a"
                              Margin="0,0,0,10" TextAlignment="Center"/>
                    <TextBlock Text="Выберите существующую базу данных из списка"
                              FontSize="13" Foreground="#666666" 
                              Margin="0,0,0,25" TextAlignment="Center"/>

                    <!-- КОМБОБОКС -->
                    <ComboBox x:Name="DatabaseComboBox"
                             Height="50"
                             FontSize="15"
                             Margin="0,0,0,25"
                             SelectionChanged="DatabaseComboBox_SelectionChanged">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <ToggleButton x:Name="ToggleButton"
                                                            Grid.Column="2"
                                                            Focusable="false"
                                                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                            ClickMode="Press">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate>
                                                            <Border Background="White"
                                                                   BorderBrush="#2196F3"
                                                                   BorderThickness="2"
                                                                   CornerRadius="8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition/>
                                                                        <ColumnDefinition Width="40"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter Grid.Column="0"
                                                                                    Margin="12,0,0,0"
                                                                                    VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Left"/>
                                                                    <Path Grid.Column="1"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Data="M 0 0 L 4 4 L 8 0 Z"
                                                                         Fill="#2196F3"/>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="ContentSite"
                                                                IsHitTestVisible="False"
                                                                Content="{TemplateBinding SelectionBoxItem}"
                                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                Margin="12,0,40,0"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left"/>
                                                <Popup x:Name="Popup"
                                                      Placement="Bottom"
                                                      IsOpen="{TemplateBinding IsDropDownOpen}"
                                                      AllowsTransparency="True"
                                                      Focusable="False"
                                                      PopupAnimation="Slide">
                                                    <Grid x:Name="DropDown"
                                                         SnapsToDevicePixels="True"
                                                         MinWidth="{TemplateBinding ActualWidth}"
                                                         MaxHeight="200">
                                                        <Border Background="White"
                                                               BorderBrush="#2196F3"
                                                               BorderThickness="2"
                                                               CornerRadius="8"
                                                               Margin="0,5,0,0">
                                                            <Border.Effect>
                                                                <DropShadowEffect ShadowDepth="4" Color="#000000" Opacity="0.2" BlurRadius="10"/>
                                                            </Border.Effect>
                                                            <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Height" Value="45"/>
                                <Setter Property="Padding" Value="12,0,12,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#E3F2FD"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#BBDEFB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBoxItem Content="database1.db" FontSize="14"/>
                        <ComboBoxItem Content="database2.db" FontSize="14"/>
                        <ComboBoxItem Content="database3.db" FontSize="14"/>
                        <ComboBoxItem Content="testdb.db" FontSize="14"/>
                    </ComboBox>

                    <!-- КНОПКА ВЫБРАТЬ -->
                    <Button Content="Выбрать"
                           Height="50"
                           Style="{StaticResource PrimaryButtonStyle}"
                           Click="SelectDatabase_Click"
                           x:Name="SelectDatabaseButton"
                           IsEnabled="False"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>