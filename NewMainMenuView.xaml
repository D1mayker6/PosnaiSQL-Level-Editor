<UserControl x:Class="PosnaiSQLauncher.NewMainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Главный контейнер с трансформацией для анимации -->
    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Grid.RenderTransform>
            <ScaleTransform/>
        </Grid.RenderTransform>
        
        <!-- Анимация появления при загрузке -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0" To="1"
                                       Duration="0:0:0.5"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       From="0.95" To="1"
                                       Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <ExponentialEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       From="0.95" To="1"
                                       Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <ExponentialEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- ДЕКОРАТИВНЫЕ АНИМИРУЮЩИЕСЯ ОКРУЖНОСТИ -->
        <Canvas IsHitTestVisible="False" Opacity="0.12">
            
            <!-- ОКРУЖНОСТЬ 1 - слева вверху -->
            <Ellipse Canvas.Left="-80" Canvas.Top="-100" Width="300" Height="300" 
                    Fill="#FFFFFF" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Circle1Translate"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Circle1Translate"
                                               Storyboard.TargetProperty="Y"
                                               From="0" To="500" Duration="0:0:20"
                                               AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="Circle1Translate"
                                               Storyboard.TargetProperty="X"
                                               From="0" To="200" Duration="0:0:20"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- ОКРУЖНОСТЬ 2 - справа внизу -->
            <Ellipse Canvas.Right="-120" Canvas.Bottom="-80" Width="280" Height="280" 
                    Fill="#FFFFFF" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Circle2Translate"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Circle2Translate"
                                               Storyboard.TargetProperty="Y"
                                               From="0" To="-450" Duration="0:0:24"
                                               AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="Circle2Translate"
                                               Storyboard.TargetProperty="X"
                                               From="0" To="-250" Duration="0:0:24"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- ОКРУЖНОСТЬ 3 - слева внизу -->
            <Ellipse Canvas.Left="-100" Canvas.Bottom="-120" Width="260" Height="260" 
                    Fill="#FFFFFF" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Circle3Translate"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Circle3Translate"
                                               Storyboard.TargetProperty="Y"
                                               From="0" To="-400" Duration="0:0:22"
                                               AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="Circle3Translate"
                                               Storyboard.TargetProperty="X"
                                               From="0" To="300" Duration="0:0:22"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- ОКРУЖНОСТЬ 4 - справа вверху -->
            <Ellipse Canvas.Right="-90" Canvas.Top="-110" Width="240" Height="240" 
                    Fill="#FFFFFF" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Circle4Translate"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Circle4Translate"
                                               Storyboard.TargetProperty="Y"
                                               From="0" To="480" Duration="0:0:18"
                                               AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="Circle4Translate"
                                               Storyboard.TargetProperty="X"
                                               From="0" To="-200" Duration="0:0:18"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- ОКРУЖНОСТЬ 5 - центр -->
            <Ellipse Canvas.Left="350" Canvas.Top="250" Width="200" Height="200" 
                    Fill="#FFFFFF" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="Circle5Translate"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="Circle5Translate"
                                               Storyboard.TargetProperty="Y"
                                               From="0" To="300" Duration="0:0:19"
                                               AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetName="Circle5Translate"
                                               Storyboard.TargetProperty="X"
                                               From="0" To="-350" Duration="0:0:19"
                                               AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Canvas>

        <!-- ПОЛУПРОЗРАЧНЫЙ БЛОК ПО ЦЕНТРУ -->
        <Border CornerRadius="20"
                Background="#E0FFFFFF"
                Margin="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="8" 
                                 Color="#000000" 
                                 Opacity="0.25" 
                                 BlurRadius="16"/>
            </Border.Effect>

            <!-- КОНТЕНТ ВНУТРИ БЛОКА -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Image Grid.Row="0"
                       MaxHeight="280" 
                       MaxWidth="280"
                       Margin="30,40,30,20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="pack://application:,,,/Assets/logo.png"
                       Stretch="Uniform"/>

                <!-- Надпись -->
                <StackPanel Grid.Row="1"
                           HorizontalAlignment="Center"
                           Margin="20,10,20,30">
                    <TextBlock Text="Добро пожаловать!"
                              FontSize="22"
                              FontWeight="Bold"
                              Foreground="#1a1a1a"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"/>
                    
                    <TextBlock Text="Редактор уровней"
                              FontSize="18"
                              Foreground="#1E88E5"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              Margin="0,5,0,0"/>

                    <TextBlock Text="«Создавайте и управляйте SQL задачами»"
                              FontSize="12"
                              Foreground="#666666"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              Margin="0,15,0,0"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Row="2"
                           HorizontalAlignment="Center"
                           Width="320"
                           Margin="20,0,20,40">
                    
                    <Button Content="✚  Создать новый вариант"
                           Style="{StaticResource PrimaryButtonStyle}"
                           Click="CreateButton_Click"
                           Margin="0,0,0,16"/>

                    <Button Content="✎  Редактировать существующий"
                           Style="{StaticResource SecondaryButtonStyle}"
                           Click="EditButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
    </Grid>
</UserControl>