<UserControl x:Class="PosnaiSQLauncher.NewMainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">
    
    <!-- Анимация появления -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0" To="1"
                                   Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <!-- БЕЛЫЙ БЛОК -->
    <Border CornerRadius="20"
            Background="#E8FFFFFF"
            Margin="40"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="8" Color="#000000" Opacity="0.25" BlurRadius="16"/>
        </Border.Effect>

        <StackPanel>
    <!-- КОНТЕНТ -->
    <StackPanel Margin="30,15,30,30" VerticalAlignment="Center" HorizontalAlignment="Center">
        
        <!-- Логотип -->
        <Image Width="350" Height="200" 
               Source="pack://application:,,,/Assets/logo.png"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               Margin="0,0,0,15"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Название -->
        <TextBlock Text="Добро пожаловать!"
                  FontSize="28"
                  FontWeight="Bold"
                  Foreground="#1a1a1a"
                  HorizontalAlignment="Center"
                  TextAlignment="Center"
                  Margin="0,0,0,12"/>

        <TextBlock Text="Редактор уровней"
                  FontSize="16"
                  Foreground="#1E88E5"
                  HorizontalAlignment="Center"
                  TextAlignment="Center"
                  Margin="0,0,0,8"/>

        <TextBlock Text="«Создавайте и управляйте SQL задачами»"
                  FontSize="12"
                  Foreground="#888888"
                  HorizontalAlignment="Center"
                  TextAlignment="Center"
                  Margin="0,0,0,25"/>

        <!-- Кнопки -->
        <Grid HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка 1 -->
            <Button Grid.Row="0"
                   Content="✚  Создать новый вариант"
                   Style="{StaticResource PrimaryButtonStyle}"
                   Height="60"
                   MinWidth="350"
                   Click="CreateButton_Click"/>

            <!-- Кнопка 2 -->
            <Button Grid.Row="2"
                   Content="✎  Редактировать существующий"
                   Style="{StaticResource SecondaryButtonStyle}"
                   Height="60"
                   MinWidth="350"
                   Click="EditButton_Click"/>
        </Grid>
    </StackPanel>
</StackPanel>
    </Border>
</UserControl>