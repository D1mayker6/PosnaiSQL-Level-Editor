<UserControl x:Class="PosnaiSQLauncher.NewEditOptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">

    <UserControl.Resources>
        <!-- СТИЛЬ ВЫПАДАЮЩИХ ПУНКТОВ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E3F2FD"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СТИЛЬ ВЫПАДАШКИ (Ширина совпадает со списком) -->
        <Style x:Key="StyledComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate>
                                        <Border Background="White" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#2196F3"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,40,0" VerticalAlignment="Center"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Slide">
                                <!-- Ширина выпадашки привязана к ширине контрола -->
                                <Border Background="White" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="10" Margin="0,5,0,5" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect><DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="3"/></Border.Effect>
                                    <ScrollViewer MaxHeight="250" Margin="5"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="0"/><Setter Property="Width" Value="50"/><Setter Property="Height" Value="40"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style x:Key="PlusButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="28"/><Setter Property="Foreground" Value="#2196F3"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#1976D2"/></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/></Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Border x:Name="MainBorder" CornerRadius="20" Background="#E8FFFFFF" Margin="30" Width="800" Height="620" Opacity="0.3" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect ShadowDepth="8" Color="Black" Opacity="0.2" BlurRadius="15"/></Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="10,20,10,5">
                    <StackPanel Margin="35,0,35,20">

                        <!-- 1. БАЗА ДАННЫХ -->
                        <Grid Margin="0,0,0,60">
                            <TextBlock Text="1"
                                       FontSize="200"
                                       FontWeight="Bold"
                                       Foreground="#05000000"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,-30,0,0"
                                       IsHitTestVisible="False"/>                            <StackPanel>
                                <TextBlock Text="База данных" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1a1a1a"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox Style="{StaticResource StyledComboBox}">
                                        <ComboBoxItem Content="Вариант 1: Основы Select"/><ComboBoxItem Content="Вариант 2: Сложные соединения"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="➕" Style="{StaticResource PlusButtonStyle}"/>
                                </Grid>

                                <TextBlock Text="Имя базы данных" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Height="45" FontSize="18" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,25"/>

                                <!-- БЛОК СХЕМЫ -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Схема базы данных" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="📁 Обзор"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Left"
                                            MinWidth="110"
                                            Padding="15,0"/>                                </Grid>
                                <Border x:Name="ImagePreviewBorder" Width="350" Height="350" BorderThickness="2" BorderBrush="#E0E0E0" CornerRadius="10" Background="#F9F9F9" HorizontalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="ImagePreview" Stretch="Uniform"/>
                                        <StackPanel x:Name="ImagePlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🖼️" FontSize="80" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Выберите схему" FontSize="13" Foreground="#999999" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 2. ЗАПРОС -->
                        <Grid Margin="0,0,0,60">
                            <TextBlock Text="2" FontSize="200" FontWeight="Bold" Foreground="#08000000" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <StackPanel>
                                <TextBlock Text="Запрос" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox Style="{StaticResource StyledComboBox}">
                                        <ComboBoxItem Content="Новый запрос (пустой)"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="➕" Style="{StaticResource PlusButtonStyle}"/>
                                </Grid>
                                <TextBlock Text="Имя запроса" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox Height="45" FontSize="16" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                                <TextBlock Text="Условие задачи" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox Height="80" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>
                                <TextBlock Text="Текст SQL кода" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox Height="120" Padding="10" FontFamily="Courier New" AcceptsReturn="True"/>
                            </StackPanel>
                        </Grid>

                        <!-- 3. ЛОКАЦИЯ И ТАЙМЕР -->
                        <Grid Margin="0,0,0,40">
                            <TextBlock Text="3" FontSize="200" FontWeight="Bold" Foreground="#08000000" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <StackPanel>
                                <TextBlock Text="Выбор локации" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                                <Grid HorizontalAlignment="Center" Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <Border x:Name="CardDesert" Grid.Column="0" CornerRadius="15" Background="White" BorderThickness="2" BorderBrush="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="CardDesert_Click">
                                        <StackPanel Margin="15">
                                            <Border Width="60" Height="60" Background="#FFF3E0" CornerRadius="30" Margin="0,0,0,10"><Image Source="pack://application:,,,/Assets/desert.png" Width="35" Stretch="Uniform"/></Border>
                                            <TextBlock Text="Знойная пустыня" FontSize="16" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="CardForest" Grid.Column="2" CornerRadius="15" Background="White" BorderThickness="2" BorderBrush="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="CardForest_Click">
                                        <StackPanel Margin="15">
                                            <Border Width="60" Height="60" Background="#E8F5E9" CornerRadius="30" Margin="0,0,0,10"><Image Source="pack://application:,,,/Assets/forest.png" Width="35" Stretch="Uniform"/></Border>
                                            <TextBlock Text="Шёпот листвы" FontSize="16" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Лимит времени" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <Border Background="#08000000" CornerRadius="15" Padding="15,10" HorizontalAlignment="Center" MinWidth="400">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal"><Button Content="-30" Click="TimeMinus30_Click" Style="{StaticResource TimerButtonStyle}"/><Button Content="-5" Click="TimeMinus5_Click" Style="{StaticResource TimerButtonStyle}"/></StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <StackPanel Width="55"><TextBlock x:Name="MinDisplay" Text="05" FontSize="36" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="МИН" FontSize="8" HorizontalAlignment="Center"/></StackPanel>
                                            <TextBlock Text=":" FontSize="36" Margin="5,-5,5,0"/><StackPanel Width="55"><TextBlock x:Name="SecDisplay" Text="00" FontSize="36" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="СЕК" FontSize="8" HorizontalAlignment="Center"/></StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal"><Button Content="+5" Click="TimePlus5_Click" Style="{StaticResource TimerButtonStyle}"/><Button Content="+30" Click="TimePlus30_Click" Style="{StaticResource TimerButtonStyle}"/></StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ПАНЕЛЬ КНОПОК -->
                <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="0,1,0,0" Padding="20,15" CornerRadius="0,0,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="← Вернуться в главное меню" Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click" HorizontalAlignment="Left" MinWidth="300" Height="45"/>
                        <Button Grid.Column="1" Content="💾 Сохранить изменения" Style="{StaticResource PrimaryButtonStyle}"  Width="250" Height="45"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ОВЕРЛЕЙ ВЫБОРА -->
        <Grid x:Name="VariantOverlay" Background="#B0000000">
            <Border x:Name="VariantPanel" Background="#E8FFFFFF" CornerRadius="20" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="35">
                <StackPanel>
                    <TextBlock Text="Режим редактирования" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    <ComboBox x:Name="VariantComboBox" Style="{StaticResource StyledComboBox}" Margin="0,0,0,30" SelectionChanged="VariantComboBox_SelectionChanged">
                        <ComboBoxItem Content="Вариант 1: Основы Select"/><ComboBoxItem Content="Вариант 2: Сложные соединения"/>
                    </ComboBox>
                    <Button x:Name="OpenVariantButton" Content="Открыть и редактировать" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="OpenVariant_Click" HorizontalAlignment="Stretch" Height="55" MinWidth="0"/>
                    <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Margin="0,15,0,0" Click="Back_Click" HorizontalAlignment="Stretch" Height="50" MinWidth="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>